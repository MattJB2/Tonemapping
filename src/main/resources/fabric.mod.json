  "authors": [
    "Matt"
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },

	"icon": "icon.png",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
    "main": [
			"matt.tonemap.Tonemap"
    ],
		"beforeGameStart": [
			"matt.tonemap.Tonemap"
		],
		"afterGameStart": [
			"matt.tonemap.Tonemap"
		],
		"recipesReady": [
			"matt.tonemap.Tonemap"
		]
	},
  "mixins": [
      "tonemap.mixins.json"
  ],

  "depends": {
		"minecraft": "*",
    "fabricloader": ">=0.15.5"
  },
