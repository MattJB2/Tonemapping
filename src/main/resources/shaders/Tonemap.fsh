vec3 adjustGamma(vec3 color, float value)
{
	return pow(color, vec3(1.0 - value + 0.5));
}

vec3 cbCorrection(vec3 tex)
{
    int mode = cbCorrectionMode;
    if (mode < 1 || mode > 4) return tex;
	
	if(mode == 4) //Grayscale
	{
		return vec3((tex.r + tex.g + tex.b) / 3.0f);
	}
	
    float L = (17.8824 * tex.r) + (43.5161 * tex.g) + (4.11935 * tex.b);
    float M = (3.45565 * tex.r) + (27.1554 * tex.g) + (3.86714 * tex.b);
    float S = (0.0299566 * tex.r) + (0.184309 * tex.g) + (1.46709 * tex.b);

	float l, m, s;
	if (mode == 1) //Protanopia
	{
		l = 0.0 * L + 2.02344 * M + -2.52581 * S;
		m = 0.0 * L + 1.0 * M + 0.0 * S;
		s = 0.0 * L + 0.0 * M + 1.0 * S;
	}

	if (mode == 2) //Deuteranopia
	{
		l = 1.0 * L + 0.0 * M + 0.0 * S;
    	m = 0.494207 * L + 0.0 * M + 1.24827 * S;
    	s = 0.0 * L + 0.0 * M + 1.0 * S;
	}

	if (mode == 3) //Tritanopia
	{
		l = 1.0 * L + 0.0 * M + 0.0 * S;
    	m = 0.0 * L + 1.0 * M + 0.0 * S;
    	s = -0.395913 * L + 0.801109 * M + 0.0 * S;
	}

	vec3 error;
    error.r = (0.0809444479 * l) + (-0.130504409 * m) + (0.116721066 * s);
    error.g = (-0.0102485335 * l) + (0.0540193266 * m) + (-0.113614708 * s);
    error.b = (-0.000365296938 * l) + (-0.00412161469 * m) + (0.693511405 * s);
    vec3 diff = tex - error;
    vec3 correction;
    correction.r = 0.0;
	correction.g =  (diff.r * 0.7) + (diff.g * 1.0);
	correction.b =  (diff.r * 0.7) + (diff.b * 1.0);
	correction = tex + correction;

	return correction;
}

vec3 otherClosestColor(vec3 color){
    float bestDistance = 1000.0;
    vec3 bestColor = vec3(0.0, 0.0, 0.0);

    for (int i = 0; i < PALETTE_SIZE; ++i) {
        float distance = distance(color, palette[i]);
        if (distance < bestDistance) {
            bestDistance = distance;
            bestColor = palette[i];
        }
    }

    return bestColor;
}

// 4x4 Bayer matrix
const float dither[16] = float[](
    0.0/16.0,  8.0/16.0,  2.0/16.0, 10.0/16.0,
    12.0/16.0,  4.0/16.0, 14.0/16.0,  6.0/16.0,
    3.0/16.0, 11.0/16.0,  1.0/16.0,  9.0/16.0,
    15.0/16.0,  7.0/16.0, 13.0/16.0,  5.0/16.0
);

void main()
{
	vec3 color = vec3(0.0);

	color = texture2D(colortex0, texcoord.xy).rgb;

	color = cbCorrection(color);
	
	color = adjustGamma(color, gamma);

    // Determine the position in the dither matrix
    int ditherX = int(mod(gl_FragCoord.x, 4.0));
    int ditherY = int(mod(gl_FragCoord.y, 4.0));
    float ditherValue = dither[ditherY * 4 + ditherX];
	
	vec3 closestColor = vec3(0.0);

	closestColor = otherClosestColor(color);

    closestColor = closestColor + (ditherValue / 255.0);

    closestColor = cbCorrection(closestColor);

	gl_FragColor = vec4(closestColor, 1.0);
}